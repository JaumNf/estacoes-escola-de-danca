# GEMINI_API_KEY: chave do Gemini usada pelo chatbot (app/api/chat/route.ts).
# Fica só no servidor — NUNCA use o prefixo NEXT_PUBLIC_, senão ela vai para o navegador.
# Em produção, configure em Vercel > Project > Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NEXT_PUBLIC_BASE_URL: URL pública do site, usada em robots.ts e sitemap.ts (opcional).
NEXT_PUBLIC_BASE_URL="https://escoladedancaestacoes.vercel.app"
