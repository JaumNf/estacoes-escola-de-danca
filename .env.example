# Copie para .env.local e preencha. O .env.local não vai para o Git.
# Na Vercel, as mesmas variáveis vão em Settings → Environment Variables.
# Atenção: variável salva só vale para deploys criados DEPOIS de salvar, e o
# nome diferencia maiúscula de minúscula.

# Chatbot (Gustavo Bot) — app/api/chat/route.ts
# Chave do Google AI Studio. Nunca use o prefixo NEXT_PUBLIC_ aqui: isso
# publicaria a chave no bundle que o visitante baixa.
GEMINI_API_KEY=

# Inscrições do Curso Intensivo — app/api/inscricao/route.ts
# URL do Web App do Apps Script, terminada em /exec.
# Como obter: scripts/planilha-inscricoes/README.md
INSCRICOES_WEBHOOK_URL=
# Segredo combinado com o Apps Script. Tem que ser idêntico ao CONFIG.TOKEN
# de scripts/planilha-inscricoes/Codigo.gs.
INSCRICOES_TOKEN=

# Opcional: usado por robots.ts e sitemap.ts. Sem ela, o padrão é a URL da
# Vercel. Defina no dia em que o domínio próprio entrar no ar.
NEXT_PUBLIC_BASE_URL=
